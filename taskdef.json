{
  "family": "aws-devops-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "aws-devops-container",
      "image": "IMAGE1_NAME",
      "cpu": 256,
      "memory": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}